<?xml version="1.0" encoding="utf-8"?>
<!-- Solo debug (TKT-070): HTTP sin cifrar hacia cualquier host, porque el servidor de la red
     local se elige en la app y no se conoce al compilar. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
