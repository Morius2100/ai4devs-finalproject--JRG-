# Copiar a .env (desarrollo) y .env.test (pruebas de integración) y ajustar.

# PostgreSQL (docker-compose.yml expone opina y opina_test en el puerto 5433
# del host para no chocar con otro PostgreSQL local en 5432)
DATABASE_URL="postgresql://opina:opina@localhost:5433/opina?schema=public"

# Auth.js v5 — secreto para firmar la sesión JWT. Generar con: npx auth secret
AUTH_SECRET="changeme-generate-a-real-secret"

# Almacenamiento de imágenes S3-compatible (MinIO en local, docker-compose.yml)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="opina-images"
S3_ACCESS_KEY_ID="opina"
S3_SECRET_ACCESS_KEY="opina123"
S3_PUBLIC_URL="http://localhost:9000/opina-images"

# "memory" en .env.test: las pruebas de integración no dependen de MinIO.
# Sin definir (o cualquier otro valor) usa S3ImageStorage.
# IMAGE_STORAGE="memory"
